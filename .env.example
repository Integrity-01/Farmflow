# --- Runtime ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
API_PROXY_TARGET=http://localhost:4000
APP_TIMEZONE=Africa/Lagos

# --- Frontend (Vite) ---
# Leave empty to use the dev proxy (/api -> API_PROXY_TARGET).
# In production (Vercel) set VITE_API_URL=https://farmflow-ap.onrender.com/api
VITE_API_URL=

# --- Database (MySQL/MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=farmflow
# Optional override (URL form): DATABASE_URL=mysql://root:@localhost:3306/farmflow
# Aiven / managed MySQL (production): set DB_SSL=true, paste the CA into
# DB_SSL_CA, or set DB_SSL_REJECT_UNAUTHORIZED=false to skip chain verification.
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Cross-site cookies (production: Vercel web + Render API) ---
# "auto" => SameSite=None in production, Lax in development.
COOKIE_SAMESITE=auto

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Storage ---
STORAGE_URL=

# --- Email provider (smtp | resend | sendgrid | ses) ---
# Console/log mode when SMTP details are left empty (dev only)
EMAIL_PROVIDER=smtp
EMAIL_FROM=FarmFlow <int3grity.01@gmail.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_API_KEY=

# --- Web push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:int3grity.01@gmail.com

# --- OpenAI (Phase 15, optional) ---
OPENAI_API_KEY=
