# --- Runtime ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
API_PROXY_TARGET=http://localhost:4000
APP_TIMEZONE=Africa/Lagos

# --- Frontend (Vite) ---
# Leave empty to use the dev proxy (/api -> API_PROXY_TARGET)
VITE_API_URL=

# --- Database (MySQL/MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=farmflow
# Optional override (URL form): DATABASE_URL=mysql://root:@localhost:3306/farmflow

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Storage ---
STORAGE_URL=

# --- Email provider (smtp | resend | sendgrid | ses) ---
# Console/log mode when SMTP details are left empty (dev only)
EMAIL_PROVIDER=smtp
EMAIL_FROM=FarmFlow <int3grity.01@gmail.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_API_KEY=

# --- Web push ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:int3grity.01@gmail.com

# --- OpenAI (Phase 15, optional) ---
OPENAI_API_KEY=
