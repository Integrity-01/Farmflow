# Hashed build assets are immutable once published (never re-requested while
# online). Order matters: this rule runs FIRST, the shell no-store rule below
# runs LAST and overrides it for sw.js (kept mutable so the browser detects
# service-worker updates).
# Chrome requires a JSON content type to accept the web manifest.
AddType application/manifest+json .webmanifest

<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# The app shell must never be cached long-term, otherwise browsers keep an
# old index.html that references deleted (content-hashed) assets -> white
# screen / stale app after every rebuild.
<FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
  Header set Cache-Control "no-store"
</FilesMatch>